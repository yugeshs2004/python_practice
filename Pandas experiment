-------------------------------------------------------------------- Example 
Concept: pd.merge() combines two DataFrames using a common column, just like SQL JOIN.

import pandas as pd

# Customers Table
customers = pd.DataFrame({
    'CustomerID': [1, 2, 3],
    'Name': ['Alice', 'Bob', 'Charlie']
})

# Orders Table
orders = pd.DataFrame({
    'OrderID': [101, 102, 103, 104],
    'CustomerID': [1, 2, 1, 3],
    'Product': ['Shirt', 'Pant', 'Shoes', 'Hat']
})

result = pd.merge(customers, orders, on='CustomerID', how='inner')

print("Inner Join:")
print(result)

output:--------
   CustomerID     Name  OrderID Product
0           1    Alice      101   Shirt
1           1    Alice      103   Shoes
2           2      Bob      102    Pant
3           3  Charlie      104     Hat
